# SimpliTV - ejemplo de configuración
# Los valores por defecto están pensados para una instalación doméstica en LAN.

HOST=0.0.0.0
PORT=8000
DEBUG=false

# Mantén false si accedes por HTTP local, por ejemplo http://192.168.1.19:8000.
# Actívalo únicamente cuando los usuarios entren siempre mediante HTTPS.
SECURE_COOKIES=false
ENABLE_HSTS=false

# La documentación interactiva de FastAPI está deshabilitada por defecto.
# Habilítala solo cuando la necesites para desarrollo/depuración.
ENABLE_API_DOCS=false

SESSION_EXPIRE_DAYS=7
SESSION_ABSOLUTE_MAX_DAYS=30

# Lista separada por comas de proxies que controlas y desde los que SimpliTV
# puede aceptar X-Forwarded-For. Admite IPs y CIDR. Déjalo vacío si accedes
# directamente a SimpliTV.
# Ejemplo para un reverse proxy/cloudflared local:
# TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=

# Opcional para despliegues públicos: hosts aceptados, separados por comas.
# Déjalo vacío en LAN para permitir IP local, localhost y nombres mDNS.
# ALLOWED_HOSTS=tv.example.com
ALLOWED_HOSTS=

# Límites defensivos. Normalmente no es necesario modificarlos.
MAX_REQUEST_BODY_BYTES=2097152
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_MAX_FAILURES=25

# Opcionales:
# MEDIA_DIR=/ruta/a/media
# DATABASE_URL=sqlite:///./simplitv.db
